# Never commit real credentials. Configure these in the deployment environment.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Railway release inspection
RAILWAY_TOKEN=
RAILWAY_TOKEN_TYPE=project
RAILWAY_HEALTH_URL=https://ember-signal-backend-production.up.railway.app/api/health

# Render release inspection
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_HEALTH_URL=

# PythonAnywhere management client
PYTHONANYWHERE_USERNAME=Kbnb
PYTHONANYWHERE_DOMAIN=kbnb.pythonanywhere.com
PYTHONANYWHERE_HOST=www.pythonanywhere.com
PYTHONANYWHERE_API_KEY=
PYTHONANYWHERE_SOURCE_DIRECTORY=/home/Kbnb/ember-signal-backend-staging
PYTHONANYWHERE_HEALTH_URL=https://kbnb.pythonanywhere.com/api/health

# Optional Cloudflare API check
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Optional OpenRouter release summary
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
